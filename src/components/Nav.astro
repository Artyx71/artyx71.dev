---
const pathname = Astro.url.pathname
const base = import.meta.env.BASE_URL.replace(/\/$/, '') // '/artyx71.dev' in prod, '' in dev

function isActive(href: string): boolean {
  if (href === base || href === `${base}/`) return pathname === href || pathname === `${base}/`
  return pathname.startsWith(href)
}

const links = [
  { href: `${base}/projects`, label: 'projects' },
  { href: `${base}/notes`,    label: 'notes'    },
  { href: `${base}/setup`,    label: 'setup'    },
  { href: `${base}/contact`,  label: 'contact'  },
]
---

<nav class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 py-8">
  <a
    href={`${base}/`}
    class="font-mono text-sm text-text2 transition-colors hover:text-accent"
  >
    Andrew Gabaraev
  </a>

  <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-1 list-none">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class={`font-mono text-sm transition-colors hover:text-accent ${
            isActive(href) ? 'text-accent' : 'text-text2'
          }`}
        >
          {label}
        </a>
      </li>
    ))}
    <li>
      <a
        href="https://github.com/Artyx71"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-sm text-text2 transition-colors hover:text-accent"
      >
        github&#x2197;
      </a>
    </li>
  </ul>
</nav>
