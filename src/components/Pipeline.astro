---
interface Props {
  steps: string[]
  direction?: 'horizontal' | 'vertical'
}

const { steps, direction = 'horizontal' } = Astro.props
---

{direction === 'horizontal' ? (
  <div class="font-mono text-sm text-text2 leading-relaxed">
    <span class="text-text3 text-xs uppercase tracking-widest block mb-2">pipeline</span>
    <span>{steps.join(' → ')}</span>
  </div>
) : (
  <div class="font-mono text-sm text-text2 leading-relaxed">
    <span class="text-text3 text-xs uppercase tracking-widest block mb-2">pipeline</span>
    <ul class="list-none space-y-1">
      {steps.map((step, i) => (
        <li>
          {i < steps.length - 1 ? `${step}` : step}
          {i < steps.length - 1 && <span class="block text-text3 pl-2">↓</span>}
        </li>
      ))}
    </ul>
  </div>
)}
