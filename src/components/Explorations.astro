---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

<div class="font-mono text-sm text-text2 leading-relaxed">
  <span class="text-text3 text-xs uppercase tracking-widest block mb-2">currently exploring</span>
  <ul class="list-none space-y-1">
    {items.map((item) => (
      <li>· {item}</li>
    ))}
  </ul>
</div>
