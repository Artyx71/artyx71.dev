---
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Pipeline from '@/components/Pipeline.astro'
import Explorations from '@/components/Explorations.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'projects'>
}

const { entry } = Astro.props
const { Content } = await entry.render()
const { title, tagline, status, github, pipeline, explorations } = entry.data
---

<BaseLayout title={title} description={tagline}>
  <article class="py-12">
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects`}
      class="font-mono text-xs text-text2 hover:text-accent transition-colors block mb-10"
    >
      ← back to projects
    </a>

    <h1 class="text-2xl font-semibold text-text1 mb-2">{title}</h1>
    <p class="text-text2 text-sm mb-1">{tagline}</p>
    <p class="font-mono text-xs text-text3 mb-8">status: {status}</p>

    {pipeline && pipeline.length > 0 && (
      <div class="mb-8">
        <Pipeline steps={pipeline} />
      </div>
    )}

    {explorations && explorations.length > 0 && (
      <div class="mb-8">
        <Explorations items={explorations} />
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {github && (
      <div class="mt-10 pt-6 border-t border-border">
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-text2 hover:text-accent transition-colors"
        >
          → {github.replace('https://', '')}&#x2197;
        </a>
      </div>
    )}
  </article>
</BaseLayout>
