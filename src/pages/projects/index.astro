---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectRow from '@/components/ProjectRow.astro'

const projects = await getCollection('projects')
const sorted = projects.sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<BaseLayout
  title="Projects"
  description="Engineering projects by Andrew Gabaraev — devtools, runtime tooling, and interactive systems."
>
  <section class="py-12">
    <p class="font-mono text-xs text-text3 uppercase tracking-widest mb-6">projects/</p>

    <div>
      {sorted.map((project) => (
        <ProjectRow
          title={project.data.title}
          tagline={project.data.tagline}
          status={project.data.status}
          href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${project.slug}`}
        />
      ))}
      <div class="border-t border-border" />
    </div>
  </section>
</BaseLayout>
