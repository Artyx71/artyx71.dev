---
import BaseLayout from '@/layouts/BaseLayout.astro'

const links = [
  { label: 'email',    href: 'mailto:gabaraev.andrey@gmail.com', display: 'gabaraev.andrey@gmail.com' },
  { label: 'github',   href: 'https://github.com/Artyx71',  display: 'github.com/Artyx71', external: true },
  { label: 'telegram', href: 'https://t.me/Artyx71',        display: 't.me/Artyx71', external: true },
]
---

<BaseLayout
  title="Contact"
  description="Get in touch with Andrew Gabaraev."
>
  <section class="py-12">
    <p class="font-mono text-xs text-text3 uppercase tracking-widest mb-8">contact/</p>

    <div class="space-y-4">
      {links.map(({ label, href, display, external }) => (
        <div class="flex items-baseline gap-6">
          <span class="font-mono text-xs text-text3 w-12">{label}</span>
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="font-mono text-sm text-text2 hover:text-accent transition-colors"
          >
            {display}{external && '↗'}
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
