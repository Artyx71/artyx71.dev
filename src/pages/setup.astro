---
import BaseLayout from '@/layouts/BaseLayout.astro'

const sections = [
  {
    label: 'editor',
    lines: ['Neovim with LazyVim. LSP-first, frontend stack: React/Vue/TS/Tailwind.'],
    link: { label: 'nvim-dotfiles', href: 'https://github.com/Artyx71/nvim-dotfiles' },
  },
  {
    label: 'window manager',
    lines: ['Omarchy. Opinionated Hyprland-based Linux desktop.'],
    link: { label: 'basecamp/omarchy', href: 'https://github.com/basecamp/omarchy' },
  },
  {
    label: 'terminal',
    lines: ['Alacritty. GPU-accelerated, zero latency.'],
    link: { label: 'alacritty/alacritty', href: 'https://github.com/alacritty/alacritty' },
  },
  {
    label: 'shell',
    lines: ['zsh + oh-my-zsh.'],
    link: { label: 'ohmyzsh/ohmyzsh', href: 'https://github.com/ohmyzsh/ohmyzsh' },
  },
  {
    label: 'multiplexer',
    lines: ['tmux. session management for long-running dev tasks.'],
    link: { label: 'tmux-dotfiles', href: 'https://github.com/Artyx71/tmux-dotfiles' },
  },
]
---

<BaseLayout
  title="Setup"
  description="Development environment — editor, window manager, terminal, shell, and multiplexer."
>
  <section class="py-12">
    <p class="font-mono text-xs text-text3 uppercase tracking-widest mb-8">setup/</p>

    <div class="space-y-8">
      {sections.map(({ label, lines, link }) => (
        <div>
          <p class="font-mono text-xs text-text3 uppercase tracking-widest mb-2">{label}</p>
          {lines.map((line) => (
            <p class="text-sm text-text2 mb-1">{line}</p>
          ))}
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs text-text2 hover:text-accent transition-colors"
          >
            → {link.label}&#x2197;
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
