---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const NOTES_PER_PAGE = 10

const notes = await getCollection('notes')
const sorted = notes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)

const totalPages = Math.ceil(sorted.length / NOTES_PER_PAGE)
const page = sorted.slice(0, NOTES_PER_PAGE)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<BaseLayout
  title="Notes"
  description="Engineering notes by Andrew Gabaraev on devtools, runtime systems, and browser internals."
>
  <section class="py-12">
    <p class="font-mono text-xs text-text3 uppercase tracking-widest mb-6">notes/</p>

    <div class="space-y-6">
      {page.map((note) => (
        <a
          href={`${base}/notes/${note.slug}`}
          class="block group"
        >
          <div class="flex flex-col gap-1">
            <span class="font-mono text-xs text-text2">{note.data.date}</span>
            <span class="text-sm text-text1 group-hover:text-accent transition-colors">
              {note.data.title}
            </span>
            <span class="text-xs text-text2">{note.data.lede}</span>
          </div>
        </a>
      ))}
    </div>

    {totalPages > 1 && (
      <div class="flex items-center justify-between mt-12 font-mono text-xs text-text2">
        <span class="text-text3">page 1 / {totalPages}</span>
        <a
          href={`${base}/notes/2`}
          class="hover:text-accent transition-colors"
        >
          next →
        </a>
      </div>
    )}
  </section>
</BaseLayout>
