---
import { getCollection, type CollectionEntry } from 'astro:content'
import ProseLayout from '@/layouts/ProseLayout.astro'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  return notes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'notes'>
}

const { entry } = Astro.props
const { Content } = await entry.render()
const { title, date, lede } = entry.data
---

<ProseLayout title={title} description={lede}>
  <a
    href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes`}
    class="font-mono text-xs text-text2 hover:text-accent transition-colors block mb-10 not-prose"
  >
    ← back to notes
  </a>

  <p class="font-mono text-xs text-text2 mb-2">{date}</p>
  <h1 class="text-2xl font-semibold text-text1 mb-3 leading-tight">{title}</h1>
  <p class="text-text2 text-sm mb-10 border-b border-border pb-8">{lede}</p>

  <Content />
</ProseLayout>
